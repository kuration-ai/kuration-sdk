{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kuration.dev/schemas/job.schema.json",
  "title": "kuration job spec",
  "description": "One JSON document wiring a curation run: schema + adapter + sources + segmenter + strategy (+ output for curate, arms for experiment). Point your editor's $schema at this file for autocomplete; kur-validate runs the SDK's richer load-time validators.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_schema_version": {"type": "string", "default": "1.0"},
    "schema": {
      "description": "A SchemaSpec (inline) or a path to one. Omit only when the adapter derives its own (e.g. the curated adapter).",
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["name"],
          "anyOf": [{"required": ["fields"]}, {"required": ["media"]}],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "entity_axis": {"type": ["string", "null"]},
            "sample_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["kind"],
                "additionalProperties": false,
                "properties": {
                  "kind": {"enum": ["scalar", "vector", "categorical"]},
                  "dims": {"type": "array", "items": {"type": "string"}},
                  "semantics": {"enum": [null, "position", "angular", "bitmask"]},
                  "bits": {"type": "object", "additionalProperties": {"type": "integer"}},
                  "max_rate": {"type": ["number", "null"]}
                }
              }
            },
            "event_streams": {"type": "object"},
            "globals": {"type": "object"},
            "media": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["kind", "dtype", "shape"],
                "additionalProperties": false,
                "properties": {
                  "kind": {"enum": ["video-frame"]},
                  "dtype": {"type": "string"},
                  "shape": {"type": "array", "minItems": 1,
                            "items": {"type": "integer", "minimum": 1}},
                  "layout": {"enum": ["HWC", "CHW"]},
                  "color_space": {"type": "string", "minLength": 1},
                  "timing": {"enum": ["pts", "frame_index"]},
                  "capabilities": {"type": "object",
                                   "additionalProperties": {"type": "boolean"}}
                }
              }
            }
          }
        }
      ]
    },
    "adapter": {
      "description": "The input adapter: {type, ...kwargs}. type is the registered adapter name.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string",
                 "examples": ["timeseries", "jsonl", "npz", "hdf5", "curated",
                              "parquet-dataset", "huggingface", "zarr"]}
      }
    },
    "sources": {
      "description": "Explicit source URIs. Omit to use the adapter's own sources() (curated/parquet-dataset/huggingface can enumerate).",
      "type": "array",
      "items": {"type": "string"}
    },
    "segmenter": {
      "type": "object",
      "required": ["window", "stride"],
      "additionalProperties": false,
      "properties": {
        "window": {"type": "number", "exclusiveMinimum": 0},
        "stride": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"enum": ["steps", "seconds"]},
        "sample_hz": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "strategy": {"$ref": "#/$defs/strategy"},
    "arms": {
      "description": "Experiment mode: several strategies compared over the same sources.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "strategy"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "strategy": {"$ref": "#/$defs/strategy"}
        }
      }
    },
    "baseline": {"type": "string", "description": "Experiment: arm name used as the JS-divergence reference."},
    "target_size": {"type": "integer", "minimum": 1, "description": "Experiment/report: count to select per arm."},
    "output": {
      "description": "Curate mode: the OutputSpec for training shards.",
      "type": "object",
      "required": ["shard_length", "modalities"],
      "additionalProperties": false,
      "properties": {
        "shard_length": {"type": "integer", "minimum": 1},
        "short_policy": {"enum": ["keep", "pad", "drop"]},
        "container": {"type": "string", "description": "Built-in or registered container name."},
        "presence_mask": {"type": "boolean", "default": true},
        "modalities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["dtype", "source"],
            "additionalProperties": false,
            "properties": {
              "dtype": {"type": "string"},
              "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}},
              "source": {"type": "string", "pattern": "^(field|segment|encoder|vocab|media):.+"}
            }
          }
        },
        "vocabs": {"type": "object"}
      }
    },
    "output_preset": {
      "description": "Registered preset name or {name, ...parameters}.",
      "oneOf": [{"type": "string"}, {"type": "object", "required": ["name"]}]
    },
    "encoder": {
      "type": "object", "required": ["name"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "params": {"type": "object"}}
    },
    "train_hours": {"type": "number", "minimum": 0, "description": "Curate: train budget in hours."},
    "test_hours": {"type": "number", "minimum": 0},
    "out": {"type": "string", "description": "Curate: output directory (local path or cloud URL)."},
    "seed": {"type": "integer"},
    "plugins": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "include_plugin_entry_points": {
      "type": "boolean",
      "description": "Discover installed kuration.plugins entry points (default true). Set false to use only explicit plugin modules."
    },
    "workers": {"type": "integer", "minimum": 1},
    "on_error": {"enum": ["skip", "raise"]},
    "resume": {"type": "boolean"},
    "force": {"type": "boolean"},
    "streaming": {"type": "boolean"},
    "executor": {"enum": ["local", "ray"]},
    "mode": {"enum": ["explore", "strict"]},
    "span_steps": {"type": "integer", "minimum": 1},
    "span_seconds": {"type": "number", "exclusiveMinimum": 0},
    "clip_aggregate": {"enum": ["max", "min", "mean"]},
    "memory_budget": {"type": "integer", "minimum": 1},
    "batch_size": {"type": "integer", "minimum": 1},
    "checkpoint_dir": {"type": "string", "minLength": 1},
    "spill_dir": {"type": "string", "minLength": 1},
    "approximation": {"enum": ["exact", "approximate"]},
    "max_in_flight": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "strategy": {
      "description": "A strategy: inline dict or a path to a JSON file.",
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "define": {"type": "object", "description": "name -> DSL metric spec {source, reduce, map?, filter?, scope?}"},
            "binning": {
              "type": "object",
              "properties": {
                "axes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["metric", "bins"],
                    "additionalProperties": false,
                    "properties": {"metric": {"type": "string"}, "bins": {"type": "integer", "minimum": 1}}
                  }
                }
              }
            },
            "selection": {
              "type": "object",
              "properties": {
                "method": {"type": "string", "description": "Built-in or registered method name."},
                "weights": {"type": "object", "additionalProperties": {"type": "number"}},
                "normalize": {"enum": ["quantile", "minmax", "zscore", "none"]},
                "floor": {"type": "number", "minimum": 0},
                "target": {},
                "tag_coverage": {"type": ["object", "null"]},
                "group_cap": {"type": ["object", "null"]},
                "predicates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["metric", "op", "value"],
                    "additionalProperties": false,
                    "properties": {
                      "metric": {"type": "string"},
                      "op": {"enum": [">", ">=", "<", "<=", "==", "!="]},
                      "value": {"type": "number"}
                    }
                  }
                }
              }
            },
            "feature_space": {"type": "array", "items": {"type": "string"}},
            "filters": {"type": "array", "items": {"type": "object", "required": ["type"]}},
            "tags": {},
            "scorers": {"type": "array"}
          }
        }
      ]
    }
  }
}
